<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <EditText android:id="@+id/task_search" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="@string/search_tasks"
        android:inputType="text" android:singleLine="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/filter_all" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/filter_all"/>
        <Button android:id="@+id/filter_todo" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/filter_todo"/>
        <Button android:id="@+id/filter_done" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/filter_done"/>
    </LinearLayout>
    <TextView android:id="@+id/task_summary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="8dp"
        android:text="@string/task_summary_initial"/>
    <ListView android:id="@+id/list_todo" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:emptyView="@+id/task_empty"/>
    <TextView android:id="@+id/task_empty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/no_tasks"
        android:gravity="center" android:padding="20dp" />
</LinearLayout>
